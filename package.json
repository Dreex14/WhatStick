{
  "name": "whatstick",
  "version": "1.0.3",
  "description": "Crea stickers estáticos, animados y con sonido para WhatsApp en Windows",
  "main": "app/main.js",
  "scripts": {
    "poc:generar": "node poc/generate.js",
    "poc": "electron poc/electron/main.js",
    "test": "node --test test/",
    "start": "electron .",
    "icons": "node scripts/icons.js && node scripts/icon.js",
    "dist": "electron-builder --win"
  },
  "author": "Dreex",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "lucide-static": "^1.81.0"
  },
  "private": true,
  "build": {
    "appId": "es.dreex.whatstick",
    "productName": "WhatStick",
    "copyright": "Copyright (c) 2026 Dreex",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**",
      "engine/**",
      "integration/**",
      "package.json",
      "LICENSE",
      "TERCEROS.md",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/bin/win32/x64/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app/icon/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082",
      "deleteAppDataOnUninstall": false,
      "shortcutName": "WhatStick",
      "artifactName": "WhatStick-${version}-instalador.${ext}",
      "license": "LICENSE"
    },
    "portable": {
      "artifactName": "WhatStick-${version}-portable.${ext}"
    },
    "electronLanguages": [
      "es",
      "en-US"
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
